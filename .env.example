# MongoDB connection string. Include the database name in the path.
MONGODB_URI=mongodb://127.0.0.1:27017/dsa-visualizer

# Password for the /admin area (at least 8 characters). Required: set your own.
ADMIN_PASSWORD=

# Secret used to sign the admin session cookie (at least 32 characters). Required: set your own.
# Generate one with: openssl rand -base64 48
ADMIN_SESSION_SECRET=

# Set to "true" ONLY when running behind a reverse proxy that overwrites X-Real-IP / X-Forwarded-For.
# Otherwise the login throttle uses one shared bucket (headers are client-controlled).
TRUST_PROXY=false
