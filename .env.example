# MongoDB connection string. Include the database name in the path.
MONGODB_URI=mongodb://127.0.0.1:27017/dsa-visualizer

# Password for the /admin area (at least 8 characters). Required: set your own.
ADMIN_PASSWORD=

# Secret used to sign the admin session cookie (at least 32 characters). Required: set your own.
# Generate one with: openssl rand -base64 48
ADMIN_SESSION_SECRET=

# Set to "true" ONLY when running behind a reverse proxy that overwrites X-Real-IP / X-Forwarded-For.
# Otherwise the login throttle uses one shared bucket (headers are client-controlled).
TRUST_PROXY=false

# Public origin used in canonical URLs, the sitemap and structured data (no trailing slash).
# Optional: falls back to VERCEL_PROJECT_PRODUCTION_URL, then to the production URL below.
# NEXT_PUBLIC_SITE_URL=https://dsa-visualizer-gamma-six.vercel.app

# Optional: Google Search Console "HTML tag" verification token (content value only).
GOOGLE_SITE_VERIFICATION=

# Optional: Bing Webmaster Tools verification token (content value only).
BING_SITE_VERIFICATION=
